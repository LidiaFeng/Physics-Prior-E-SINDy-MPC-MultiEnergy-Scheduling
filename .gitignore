# MATLAB temporary and autosave files
*.asv
*.autosave
*.m~
*.mlx~

# MATLAB generated files
*.mex*
*.slxc
*.slprj/
codegen/

# Large or regenerable experiment outputs
results/*.mat
results/*.xlsx
results/*step_log*.csv
results/*solver_log*.csv
figures_temp*/

# Editor and operating-system files
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*.tmp

# Keep output directories in Git when empty
!results/.gitkeep
!figures/.gitkeep
